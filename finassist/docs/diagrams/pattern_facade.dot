digraph G { rankdir=TB; nodesep=0.35; ranksep=0.7; splines=true; node [shape=plain fontname="Helvetica" fontsize=9]; edge [fontname="Helvetica" fontsize=8];
FinAssistFacade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#D5F2E8"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Facade&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FinAssistFacade</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- financialService : FinancialService<BR/>- dashboardService : DashboardService<BR/>- subscriptionService : SubscriptionService<BR/>- agentOrchestrator : AgentOrchestrator<BR/>- voiceInputService : VoiceInputService<BR/>- savingsAnalyzer : SavingsAnalyzer<BR/>- repository : FinancialRepository<BR/>- expenseDetectionAgent : ExpenseDetectionAgent<BR/>- pendingVoiceEntry : FinancialEntry</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setView(FinancialView) : void<BR/>+ logIncome(Income) : void<BR/>+ logExpense(Expense) : void<BR/>+ logVoiceEntry() : void<BR/>+ getPendingVoiceEntry() : FinancialEntry<BR/>+ confirmVoiceEntry(boolean) : void<BR/>+ getDashboard(int, int) : MonthlySummary<BR/>+ getMonthlySummary(int, int) : MonthlySummary<BR/>+ addGoal(FinancialGoal) : void<BR/>+ getGoalSummary() : String<BR/>+ getSavingsAdvice() : String<BR/>+ askCoach(String) : String<BR/>+ addSubscription(Subscription) : void<BR/>+ removeSubscription(int) : void<BR/>+ getSubscriptionSummary() : String</TD></TR></TABLE>>];
DashboardService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#D6E8FA"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;MVC: Model&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Observer: Observer&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>DashboardService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository : FinancialRepository<BR/>- cache : Map&lt;String, MonthlySummary&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ generateMonthlyDashboard(int, int) : MonthlySummary<BR/>+ calculateIncome(List&lt;FinancialEntry&gt;) : double<BR/>+ calculateExpenses(List&lt;FinancialEntry&gt;) : double<BR/>+ calculateProfit(List&lt;FinancialEntry&gt;) : double<BR/>+ calculateSavingsRate(MonthlySummary) : double<BR/>+ update() : void</TD></TR></TABLE>>];
FinancialController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#D6E8FA"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;MVC: Controller&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FinancialController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- facade : FinAssistFacade<BR/>- view : FinancialView</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setView(FinancialView) : void<BR/>+ logIncome(Income) : void<BR/>+ logExpense(Expense) : void<BR/>+ logVoiceEntry() : void<BR/>+ requestDashboard(int, int) : void<BR/>+ requestMonthlySummary(int, int) : void<BR/>+ addGoal(FinancialGoal) : void<BR/>+ requestGoalSummary() : void<BR/>+ requestSavingsAdvice() : void<BR/>+ askFinancialCoach(String) : void<BR/>+ manageSubscription(Subscription) : void<BR/>+ removeSubscription(int) : void<BR/>+ requestSubscriptions() : void</TD></TR></TABLE>>];
SubscriptionService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEEEEE"><TR><TD ALIGN="CENTER"><B>SubscriptionService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository : FinancialRepository</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addSubscription(Subscription) : void<BR/>+ removeSubscription(int) : void<BR/>+ getSubscriptions() : List&lt;Subscription&gt;<BR/>+ calculateMonthlyCost() : double</TD></TR></TABLE>>];
FinancialRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEEEEE"><TR><TD ALIGN="CENTER"><B>FinancialRepository</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- user : User<BR/>- nextEntryId : int<BR/>- nextGoalId : int<BR/>- nextSubscriptionId : int<BR/>- file : Path</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ saveEntry(FinancialEntry) : synchronized void<BR/>+ getEntries() : synchronized List&lt;FinancialEntry&gt;<BR/>+ getEntriesByMonth(int, int) : synchronized List&lt;FinancialEntry&gt;<BR/>+ saveGoal(FinancialGoal) : synchronized void<BR/>+ getGoals() : synchronized List&lt;FinancialGoal&gt;<BR/>+ saveSubscription(Subscription) : synchronized void<BR/>+ getSubscriptions() : synchronized List&lt;Subscription&gt;<BR/>+ removeSubscription(int) : synchronized void<BR/>+ persist() : synchronized void</TD></TR></TABLE>>];
VoiceInputService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEEEEE"><TR><TD ALIGN="CENTER"><B>VoiceInputService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- apiKey : String<BR/>- fallbackInput : Supplier&lt;String&gt;<BR/>- recordSeconds : int</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setFallbackInput(Supplier&lt;String&gt;) : void<BR/>+ captureSpeech() : String<BR/>+ validateTranscript(String) : boolean<BR/>+ convertToEntry(String) : FinancialEntry</TD></TR></TABLE>>];
FinancialService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#D6E8FA"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;MVC: Model&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Observer: Subject&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FinancialService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository : FinancialRepository</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addIncome(Income) : void<BR/>+ addExpense(Expense) : void<BR/>+ calculateProfit() : double<BR/>+ getMonthlyEntries(int, int) : List&lt;FinancialEntry&gt;</TD></TR></TABLE>>];
SavingsAnalyzer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FBD6E4"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Strategy: Context&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Observer: Observer&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>SavingsAnalyzer</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository : FinancialRepository<BR/>- llm : LLMService<BR/>- strategy : SavingsStrategy</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setStrategy(SavingsStrategy) : void<BR/>+ selectStrategy() : SavingsStrategy<BR/>+ analyze() : String<BR/>+ update() : void</TD></TR></TABLE>>];
AgentOrchestrator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEEEEE"><TR><TD ALIGN="CENTER"><B>AgentOrchestrator</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- agents : List&lt;FinancialAgent&gt;<BR/>- expenseDetectionCreator : AgentCreator<BR/>- financialCoachCreator : AgentCreator</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ processRequest(String) : String<BR/>+ selectAgent(String) : FinancialAgent<BR/>+ addAgent(FinancialAgent) : void</TD></TR></TABLE>>];
