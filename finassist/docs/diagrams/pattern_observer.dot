digraph G { rankdir=TB; nodesep=0.35; ranksep=0.7; splines=true; node [shape=plain fontname="Helvetica" fontsize=9]; edge [fontname="Helvetica" fontsize=8];
DashboardService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#D6E8FA"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;MVC: Model&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Observer: Observer&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>DashboardService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository : FinancialRepository<BR/>- cache : Map&lt;String, MonthlySummary&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ generateMonthlyDashboard(int, int) : MonthlySummary<BR/>+ calculateIncome(List&lt;FinancialEntry&gt;) : double<BR/>+ calculateExpenses(List&lt;FinancialEntry&gt;) : double<BR/>+ calculateProfit(List&lt;FinancialEntry&gt;) : double<BR/>+ calculateSavingsRate(MonthlySummary) : double<BR/>+ update() : void</TD></TR></TABLE>>];
ExpenseDetectionAgent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0CB"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Observer: Observer&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Factory Method: Product&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ExpenseDetectionAgent</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository : FinancialRepository<BR/>- llm : LLMService<BR/>- view : FinancialView<BR/>- lastAnalyzedId : int<BR/>- enoughHistory : boolean<BR/>- mean : double<BR/>- threshold : double<BR/>- basis : String</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setView(FinancialView) : void<BR/>+ hasEnoughHistory() : boolean<BR/>+ detectUnusualExpense(Expense) : boolean<BR/>+ analyzeExpense(Expense) : String<BR/>+ update() : void<BR/>+ process(String) : String</TD></TR></TABLE>>];
FinancialService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#D6E8FA"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;MVC: Model&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Observer: Subject&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FinancialService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository : FinancialRepository</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addIncome(Income) : void<BR/>+ addExpense(Expense) : void<BR/>+ calculateProfit() : double<BR/>+ getMonthlyEntries(int, int) : List&lt;FinancialEntry&gt;</TD></TR></TABLE>>];
SavingsAnalyzer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FBD6E4"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Strategy: Context&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Observer: Observer&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>SavingsAnalyzer</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository : FinancialRepository<BR/>- llm : LLMService<BR/>- strategy : SavingsStrategy</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setStrategy(SavingsStrategy) : void<BR/>+ selectStrategy() : SavingsStrategy<BR/>+ analyze() : String<BR/>+ update() : void</TD></TR></TABLE>>];
FinancialObserver [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0CB"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Observer: Observer&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FinancialObserver</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ update() : void</TD></TR></TABLE>>];
FinancialDataSubject [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0CB"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Observer: Subject&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FinancialDataSubject</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- observers : List&lt;FinancialObserver&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addObserver(FinancialObserver) : void<BR/>+ removeObserver(FinancialObserver) : void<BR/>+ notifyObservers() : void</TD></TR></TABLE>>];
FinancialService -> FinancialDataSubject [arrowhead=empty label=""];
