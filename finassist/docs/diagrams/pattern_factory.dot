digraph G { rankdir=TB; nodesep=0.35; ranksep=0.7; splines=true; node [shape=plain fontname="Helvetica" fontsize=9]; edge [fontname="Helvetica" fontsize=8];
FinancialAgent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E6E0F8"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Factory Method: Product&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FinancialAgent</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ process(String) : String</TD></TR></TABLE>>];
FinancialCoachAgentCreator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E6E0F8"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Factory Method: ConcreteCreator&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FinancialCoachAgentCreator</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository : FinancialRepository<BR/>- llm : LLMService</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ createAgent() : FinancialAgent</TD></TR></TABLE>>];
ExpenseDetectionAgent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0CB"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Observer: Observer&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Factory Method: Product&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ExpenseDetectionAgent</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository : FinancialRepository<BR/>- llm : LLMService<BR/>- view : FinancialView<BR/>- lastAnalyzedId : int<BR/>- enoughHistory : boolean<BR/>- mean : double<BR/>- threshold : double<BR/>- basis : String</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setView(FinancialView) : void<BR/>+ hasEnoughHistory() : boolean<BR/>+ detectUnusualExpense(Expense) : boolean<BR/>+ analyzeExpense(Expense) : String<BR/>+ update() : void<BR/>+ process(String) : String</TD></TR></TABLE>>];
FinancialCoachAgent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E6E0F8"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Factory Method: Product&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FinancialCoachAgent</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository : FinancialRepository<BR/>- llm : LLMService<BR/>- history : List&lt;String&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ process(String) : String<BR/>+ generateAdvice(String) : String<BR/>+ prepareContext() : String</TD></TR></TABLE>>];
AgentOrchestrator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEEEEE"><TR><TD ALIGN="CENTER"><B>AgentOrchestrator</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- agents : List&lt;FinancialAgent&gt;<BR/>- expenseDetectionCreator : AgentCreator<BR/>- financialCoachCreator : AgentCreator</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ processRequest(String) : String<BR/>+ selectAgent(String) : FinancialAgent<BR/>+ addAgent(FinancialAgent) : void</TD></TR></TABLE>>];
ExpenseDetectionAgentCreator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E6E0F8"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Factory Method: ConcreteCreator&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ExpenseDetectionAgentCreator</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository : FinancialRepository<BR/>- llm : LLMService</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ createAgent() : FinancialAgent</TD></TR></TABLE>>];
AgentCreator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E6E0F8"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;abstract&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&lt;&lt;Factory Method: Creator&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>AgentCreator</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ createAgent() : FinancialAgent</TD></TR></TABLE>>];
ExpenseDetectionAgent -> FinancialAgent [arrowhead=empty style=dashed label=""];
FinancialCoachAgent -> FinancialAgent [arrowhead=empty style=dashed label=""];
AgentOrchestrator -> FinancialAgent [arrowhead=vee label="agents 0..*"];
AgentOrchestrator -> AgentCreator [arrowhead=vee label="uses"];
ExpenseDetectionAgentCreator -> AgentCreator [arrowhead=empty label=""];
FinancialCoachAgentCreator -> AgentCreator [arrowhead=empty label=""];
ExpenseDetectionAgentCreator -> ExpenseDetectionAgent [arrowhead=vee style=dashed label="creates"];
FinancialCoachAgentCreator -> FinancialCoachAgent [arrowhead=vee style=dashed label="creates"];
}